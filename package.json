{
  "name": "gog-vault",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build:web": "vite build",
    "sidecar": "bun scripts/build-sidecar.ts",
    "build": "bun run sidecar && bun scripts/build-desktop.ts",
    "portable": "bun run sidecar && bun x tauri build --bundles nsis && bun scripts/build-portable.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test --isolate"
  },
  "dependencies": {
    "@fontsource/audiowide": "^5.2.8",
    "@fontsource/inter": "^5.2.8",
    "@napi-rs/keyring": "2.1.0",
    "elysia": "^1.4.0",
    "fast-xml-parser": "^5.11.1",
    "image-size": "^2.0.4",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.7.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-opener": "^2.0.0",
    "@types/bun": "latest",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}